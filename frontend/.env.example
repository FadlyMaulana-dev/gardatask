# =======================================================
# GardaTask Frontend - Environment Variables
# =======================================================
# Salin file ini ke .env dan sesuaikan dengan server Anda
# Jangan commit file .env ke git!

# URL Backend Laravel API
# Local dev  : http://localhost:8000/api
# Production : https://api.yourdomain.com/api
#              atau https://yourdomain.com/api (jika satu domain)
VITE_API_URL=http://localhost:8000/api

# Nama aplikasi
VITE_APP_NAME=GardaTask
VITE_APP_TITLE=GardaTask - Premium Task Management
VITE_APP_DESCRIPTION=Premium AI-powered project & task management system for teams and digital agencies

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_CALENDAR=true
VITE_ENABLE_AI_ASSISTANT=true

# Third-party Services (opsional)
VITE_SENTRY_DSN=
VITE_GOOGLE_ANALYTICS_ID=
